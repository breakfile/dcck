; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Declan Cavanagh in the Cathedral of Kilmister"
config/description="declan cavanagh adventures"
run/main_scene="uid://dfsscurhmb1hi"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="uid://wmq6poj36dd8"

[autoload]

Global="*uid://bnmytiuahhjxj"
DialogueBox="*uid://c314ds8qd1812"
Floor="*uid://hhrde1rx6ub5"
Fader="*uid://cq34vc30xdjow"
GlobalAudioStream="*uid://cfkcym22ce2kj"
MenuManager="*uid://bgv0eojgtij4y"

[display]

window/size/viewport_width=400
window/size/viewport_height=300
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0
window/defaults/default_clear_color=Color(0.3, 0.3, 0.3, 1)
window/canvas_textures/default_texture_filter=0

[dotnet]

project/assembly_name="Declan Cavanagh in the Cathedral of Kilmister"

[editor_plugins]

enabled=PackedStringArray("res://addons/crt/plugin.cfg")

[global_group]

Player=""

[importer_defaults]

font_data_image={
"ascent": 0,
"character_margin": Rect2i(0, 0, 0, 0),
"character_ranges": PackedStringArray(""),
"columns": 10,
"compress": true,
"descent": 0,
"fallbacks": [],
"image_margin": Rect2i(0, 0, 0, 0),
"kerning_pairs": PackedStringArray(),
"rows": 7,
"scaling_mode": 2
}

