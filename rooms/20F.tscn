script = ExtResource("8_ycixh")
dialogues = Array[String](["The moment you touched the top, my fate was sealed.", "If you slay me, I will die... and you will take over...", "...and if I return the favor... I will be arrested. And I will be forgotten forever in jail...", "So, if I truly have no other choice, I choose to fight you with dignity.", "Although you never became the ruler, your reign of terror has gone on long enough!"])
