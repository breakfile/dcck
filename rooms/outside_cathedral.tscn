[node name="DialogueInteraction4" type="Node" parent="YSort/MementoMori/InteractionLauncher" unique_id=1065939221]
script = ExtResource("8_dk675")
dialogues = Array[String](["Thus with a punch to the face I die...", "And now, with my CEREBRUM...", "...thou will take it, and [color=yellow]EQUIP it on one of your party members,", "[color=yellow]to gain access to FIRE skills and resistances!", "...What a horrible fate for a legend such as myself...", "And now, I shall die, slain by the Great Cavanagh...", "King Cohen Kilmister has surely been alerted of our existances...", "You will certainly run into guards protecting his kingdom,", "as well as others who too wish to rule this world!", "Be careful, O' young Declan, and screw you for killing me!"])
metadata/_custom_type_script = "uid://ctm3u313cygc4"

