[node name="DialogueInteraction3" type="Node" parent="YSort/MementoMori/InteractionLauncher" unique_id=1576502218]
script = ExtResource("8_dk675")
dialogues = Array[String](["'Tis thou, that villian Declan.", "Thou wish to become the ruler of the next world, doth not thee?", "So, thy plan is to destroy those in your path who also wish to achieve this dream!", "Then, at the top of this Cathedral, erected behind me as we speak,", "thou will face off with King Cavanagh, whom rules the current kingdom with sovergnity!", "Thou wishest to accomplish this so much, thou didst hired and enslaved three other members,", "and shalt use them for thou dirty work!", "I know thou wishest, as I too wish to become the next ruler of this world!", "I wield [color=yellow]THE CEREBRUM OF [color=red]WARMTH[/color][/color], a legendary gift given to me by God, granting myself the gift of fire magic!", "To accomplish thou plan, thou must destroy me, and take my CEREBRUM from me!", "But I shall not suffer that happen!", "I, [color=red]TYBALT[/color], wielder of THE CEREBRUM OF WARMTH, shall cleanse you from existance!", "Have at thee, coward!"])
metadata/_custom_type_script = "uid://ctm3u313cygc4"

