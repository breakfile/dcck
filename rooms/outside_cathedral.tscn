dialogues = Array[String](["> Declan had a vague, inexplicable vision of a silhouette man holding an owl.", "> The owl opened it's mouth, and the words:", "\"[color=red][shake]Three hours until our meeting.[/shake][/color]\" came out.", "> Declan face sagged.", "> \"[color=red][shake]Don't look at me like that.[/shake][/color]\" the owl spoke."])
