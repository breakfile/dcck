script = ExtResource("7_f3a20")
dialogues = Array[String](["...I couldn't bring myself to...", "...", "Damn it! Destroyed by my own Christmas Lights!", "...I had a deal with Cohen...", "He would... peacefully let me become the next ruler...", "But, I had to get rid of everyone else for him...", "Now I wonder...", "...", "...Declan, you...", "Whatever your heart is set on... even if I couldn't bring myself to agree...", "Just make sure you do it, okay?"])
