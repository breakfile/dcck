[node name="DialogueInteraction2" type="Node" parent="InteractionLauncher3" unique_id=537437096]
script = ExtResource("7_f3a20")
dialogues = Array[String](["This is it Declan. From now, you will proceed no longer!", "Uh, sorry about that guy... I don't know what was up with him.", "He WAS the Wielder of the Cerebrum of Strength... but I ended up taking it from him.", "Look, since that deal with [color=red][shake]Him[/shake][/color], you havent been the same.", "And I can't go around letting someone like you, with a heart of darkness take over!", "So, lets fight! For real this time!"])
metadata/_custom_type_script = "uid://ctm3u313cygc4"

