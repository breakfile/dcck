[node name="DialogueInteraction" type="Node" parent="InteractionLauncher3" unique_id=310806773]
script = ExtResource("7_f3a20")
dialogues = Array[String](["Halt, Declan! For no longer shalt you be endured...", "By the power of THE CEREBRUM OF STRENGTH, and my rifle, evermighty...", "You shalt be cleansed from existance!", "The truth is that a monster was never created!", "Instead, it was a wonderful trick hand-crafted by me, Skullduggery!", "Now, experience the power of THE CEREBRUM OF-", "...Wait... Where's my Cerebrum??", "No matter, I don't need one to destroy a puny mortal such as you!"])
metadata/_custom_type_script = "uid://ctm3u313cygc4"

