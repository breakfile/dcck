[node name="DialogueInteraction2" type="Node" parent="FastRoomExit" unique_id=925308668]
script = ExtResource("8_m8gkk")
dialogues = Array[String](["So we meet again, Declan!", "I'd love to say our last meeting went well, but... you know how it went... with... Lachlan.", "And, of course, we swore we'd never let that happen again. So why am I now trying to let that happen again?", "I mean, you and I were both there when we made our oath to [color=red][shake]Him[/shake][/color].", "Well, I'd love to tell you, but I don't really want to get into the specifics right now.", "Besides, it looks like you're breaking your oath too. Did [color=red][shake]He[/shake][/color] send you to stop me?", "You want the next CEREBRUM, though. Right?", "Here's an idea: fight me for it!", "I'd love to give you a fighting chance! The last slither of hope. You're gonna need it if you want to really defeat me later on!", "Not that I'd ever let that happen. Let's fight! I'll try not to kill you...", "...this time."])
metadata/_custom_type_script = "uid://ctm3u313cygc4"

