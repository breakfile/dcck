[node name="DialogueInteraction" type="Node" parent="InteractionLauncher" unique_id=563557382]
script = ExtResource("8_yv0bf")
dialogues = Array[String](["[color=red][shake]So, Cohen's status as the owner of the world has faded...", "[color=red][shake]You have changed what it means to be the ruler...", "[color=aqua][wave]TIME, AND THE WORLD AS YOU KNOW IT... HAS FALLEN.", "[color=red][shake]And now, a universe realized from your own thoughts, ambitions and hope... will be created.", "[color=aqua][wave]BUT, ALAS... WE ARE AFRAID WE WILL HAVE TO SEIZE THIS OPPORTUNITY FROM YOU.", "[color=red][shake]This world is ours... as it always has been.", "[color=red][shake]You and I made a pact that you will grant ownership of the world to me...", "[color=red][shake]Yet you have broken it.", "[color=aqua][wave]DARKNESS IS THE ONLY FREQUENCY YOUR HEART MANIFESTS ITSELF ONTO...", "[color=aqua][wave]MUCH LIKE TIME... YOU TOO HAVE FALLEN.", "[color=red][shake]You serve no purpose to us any longer..."])
metadata/_custom_type_script = "uid://ctm3u313cygc4"

